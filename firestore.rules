rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ATENÇÃO: sem login, qualquer pessoa com o endereço do painel pode editar estes dados.
    match /products/{id} { allow read, write: if true; }
    match /settings/{id} { allow read, write: if true; }
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(
          ['customerName','phone','items','subtotal','deliveryFee','total','notes','delivery','address','status','createdAt'])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2 && request.resource.data.customerName.size() <= 100
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50
        && request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.delivery in ['retirada','entrega']
        && request.resource.data.status == 'novo'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if true;
    }
  }
}
